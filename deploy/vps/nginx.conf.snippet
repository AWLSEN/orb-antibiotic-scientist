# Paste these blocks into /etc/nginx/sites-enabled/orbcloud, REPLACING the
# existing `location ^~ /use-cases/antibiotic-scientist { proxy_pass <vercel>; }`
# block. After the swap, /use-cases/antibiotic-scientist/* serves static HTML
# from /var/www/orbcloud/use-cases/antibiotic-scientist/ and /api/* is proxied
# to the antibiotic-api systemd service on 127.0.0.1:8091.
#
# The API block MUST come before the static block so nginx's longest-prefix
# match picks it up first for /api/ requests.

location ^~ /use-cases/antibiotic-scientist/api/ {
    # state.py expects /api/state (not /use-cases/antibiotic-scientist/api/state),
    # so strip the prefix before proxying.
    rewrite ^/use-cases/antibiotic-scientist/api/(.*)$ /api/$1 break;
    proxy_pass http://127.0.0.1:8091;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
}

location ^~ /use-cases/antibiotic-scientist {
    # Static HTML deployed by deploy-landing.yml to /var/www/orbcloud/use-cases/.
    try_files $uri $uri/ $uri/index.html =404;
}
